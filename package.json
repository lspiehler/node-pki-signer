{
  "name": "node-pki-signer",
  "version": "0.0.0",
  "private": true,
  "description": "Fast in-process X.509 signing for PKIaaS.io and IoT HSM: software keys, PKCS#11, Google Cloud KMS, post-quantum, with OpenSSL fallback",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "node --test \"src/**/*.test.ts\"",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lspiehler/node-pki-signer.git"
  },
  "author": "Lyas Spiehler",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
