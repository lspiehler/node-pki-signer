{
  "name": "node-pki-signer",
  "version": "0.3.7",
  "description": "Fast in-process X.509 signing for PKIaaS.io and IoT HSM: software keys, PKCS#11, Google Cloud KMS, post-quantum, with OpenSSL fallback",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "test": "node --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lspiehler/node-pki-signer.git"
  },
  "author": "Lyas Spiehler",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@google-cloud/kms": "6.2.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "pkcs11js": "2.1.7",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "@peculiar/asn1-csr": "3.0.0",
    "@peculiar/asn1-schema": "3.0.0",
    "@peculiar/asn1-x509": "3.0.0",
    "asn1js": "4.0.0",
    "node-openssl-cert2": "0.7.39"
  },
  "peerDependencies": {
    "@google-cloud/kms": "^6.2.1",
    "pkcs11js": "^2.1.7"
  },
  "peerDependenciesMeta": {
    "@google-cloud/kms": {
      "optional": true
    },
    "pkcs11js": {
      "optional": true
    }
  }
}
